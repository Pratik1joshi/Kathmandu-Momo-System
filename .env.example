# Production environment template — copy to .env and fill in real values.
# NEVER commit real credentials.

NODE_ENV=production

# Public site URL (no trailing slash)
APP_URL=https://pos.example.com

# cPanel injects PORT; do not hardcode in production
# PORT=3000
HOSTNAME=0.0.0.0

# PostgreSQL (URL-encode special characters in password)
# Example: postgresql://user:p%40ss@localhost:5432/pos_db
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# Pool / SSL (local cPanel Postgres usually needs no SSL)
PG_POOL_MAX=5
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=10000
PGSSL=false
# PGSSL_REJECT_UNAUTHORIZED=true

# Session / CSRF (generate long random strings)
SESSION_SECRET=change-me-to-a-long-random-string
CSRF_SECRET=change-me-to-another-long-random-string
FORCE_SECURE_COOKIES=1

# Uploads — persistent path outside release folders when possible
UPLOADS_DIR=./uploads
IMAGES_PATH=/uploads

# Logging
LOG_LEVEL=info

# Rate limits (per IP per minute)
RATE_LIMIT_LOGIN=10
RATE_LIMIT_PUBLIC=8

# First admin seed (used only by npm run db:seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeNow123!
ADMIN_FULL_NAME=Kathmandu Momo Admin

# Business identity written to system_settings by npm run db:seed.
# After go-live these are edited in Admin -> Settings, not here.
RESTAURANT_NAME=Kathmandu Momo
RESTAURANT_ADDRESS=Birendranagar, Surkhet, Karnali, Nepal
RESTAURANT_PHONE=+977 984-9216081
RECEIPT_FOOTER=Thank you for visiting Kathmandu Momo!
